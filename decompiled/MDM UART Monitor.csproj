<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>MDM UART Monitor</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net472</TargetFramework>
    <Prefer32Bit>True</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>15.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup />
  <ItemGroup>
    <Reference Include="FastColoredTextBox">
      <HintPath>extracted/app/FastColoredTextBox.dll</HintPath>
    </Reference>
    <Reference Include="Google.Apis.Sheets.v4">
      <HintPath>extracted/app/Google.Apis.Sheets.v4.dll</HintPath>
    </Reference>
    <Reference Include="Google.Apis.Auth">
      <HintPath>extracted/app/Google.Apis.Auth.dll</HintPath>
    </Reference>
    <Reference Include="System.Management" />
    <Reference Include="Google.Apis.Core">
      <HintPath>extracted/app/Google.Apis.Core.dll</HintPath>
    </Reference>
    <Reference Include="Google.Apis">
      <HintPath>extracted/app/Google.Apis.dll</HintPath>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>../../../../../usr/lib64/dotnet/shared/Microsoft.NETCore.App/10.0.12/System.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>